rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Une matière valide : nom, crédits, position, liste de notes (50 max)
    function validSubject(d) {
      return d.keys().hasOnly(['name', 'credits', 'position', 'grades'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.credits is number && d.credits >= 0 && d.credits <= 60
        && d.position is number
        && d.grades is list && d.grades.size() <= 50;
    }

    // Chaque étudiant ne peut lire et modifier QUE ses propres matières
    match /users/{uid}/subjects/{subjectId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && validSubject(request.resource.data);
    }

    // Tout le reste est interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
